# EmailJS configuration for the contact form.
# Create these in your EmailJS dashboard (https://dashboard.emailjs.com).
# Copy this file to `.env` and fill in the two missing values.

# Your EmailJS service ID (already provided)
VITE_EMAILJS_SERVICE_ID=service_wnks15x

# The email template ID (Email Templates -> your template -> Template ID, looks like `template_xxxxxxx`)
VITE_EMAILJS_TEMPLATE_ID=

# Your public key (Account -> General -> Public Key, looks like a short alphanumeric string)
VITE_EMAILJS_PUBLIC_KEY=
